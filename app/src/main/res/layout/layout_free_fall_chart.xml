<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#1E1E1E"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvChartTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Serbest Düşüş İvme Profili"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFallInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Serbest düşüş analizi..."
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/freeFallChart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:drawablePadding="4dp"
                android:text="Toplam İvme"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:drawableLeftCompat="@drawable/blue_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:drawablePadding="4dp"
                android:text="Serbest Düşüş"
                android:textColor="#8AFF8A"
                android:textSize="12sp"
                app:drawableLeftCompat="@drawable/green_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:text="Çarpma Anı"
                android:textColor="#FF595E"
                android:textSize="12sp"
                app:drawableLeftCompat="@drawable/red_dot" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>